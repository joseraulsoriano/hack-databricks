# Copia a .env y rellena. .env está en .gitignore: nunca lo subas.

# --- Databricks ---
# La autenticación se hace con `databricks auth login --profile hack` (OAuth, sin token en claro).
DATABRICKS_CONFIG_PROFILE=hack
DATABRICKS_HOST=https://dbc-19f58290-50fb.cloud.databricks.com
# SQL warehouse para las consultas del pipeline (vacío = usa el primero disponible)
DATABRICKS_WAREHOUSE_ID=b03ebf16c4226f7b

# --- Unity Catalog ---
UC_CATALOG=workspace
UC_SCHEMA=lab
UC_VOLUME=/Volumes/workspace/lab/raw

# --- Vector Search / AI Search ---
VS_ENDPOINT=lab-vs
VS_INDEX=workspace.lab.documents_curated_idx
EMBEDDING_MODEL=databricks-gte-large-en

# --- Modelos del workspace (no hay Claude en este workspace) ---
LLM_ENDPOINT=databricks-gpt-oss-120b

# --- Omnigent ---
OMNIGENT_SERVER=https://dbc-19f58290-50fb.cloud.databricks.com/omnigent

# --- APIs públicas (sin clave, pero OpenAlex da más cuota con un correo de contacto) ---
OPENALEX_MAILTO=

# --- Puente AR/VR (Meta Quest 2) ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
